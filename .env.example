# =================================================================
# TECHBOX PRODUCTION ENVIRONMENT CONFIGURATION
# Google Cloud Platform (Cloud Run, Cloud SQL, GCS) + Cloudflare
# =================================================================

# 1. DATABASE (Google Cloud SQL for PostgreSQL)
# For Cloud Run with Cloud SQL connection:
# Option A (Unix Socket): postgresql://USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# Option B (Public IP with SSL): postgresql://USER:PASSWORD@HOST_IP:5432/DB_NAME?sslmode=require
DATABASE_URL="postgresql://techbox_user:change_to_cloud_sql_password@localhost:5432/techbox?schema=public"

# 2. APPLICATION RUNTIME & SECURITY
NODE_ENV="production"
PORT=8080
# Cryptographically random 64-char hex secret (generate: openssl rand -hex 32)
AUTH_SECRET="replace_with_secure_random_64_char_hex_secret"

# 3. OBJECT STORAGE: GCS | R2 | LOCAL
STORAGE_PROVIDER="GCS"
GCS_BUCKET_NAME="techbox-production-assets"
GOOGLE_CLOUD_PROJECT="techbox-production"
# On Google Cloud Run, Application Default Credentials (ADC) are used automatically.
# In local dev: path to service account key json
GOOGLE_APPLICATION_CREDENTIALS=""

# Optional: Cloudflare R2 alternative credentials
R2_ENDPOINT=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_DOMAIN=""

# 4. PRODUCTION OTP SMS PROVIDER: FAST2SMS | TWILIO | MSG91 | DEV
OTP_PROVIDER="FAST2SMS"
FAST2SMS_API_KEY=""

# If using Twilio:
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# If using MSG91:
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# 5. PAYMENT CONFIGURATION (UPI + Manual Bank Verification)
PAYMENT_PROVIDER="UPI_MANUAL"
NEXT_PUBLIC_TECHBOX_UPI_ID="7032635858@ybl"
NEXT_PUBLIC_TECHBOX_UPI_NAME="PINNAM CHARLA CHARLA"
NEXT_PUBLIC_TECHBOX_WHATSAPP="917032635858"
NEXT_PUBLIC_TECHBOX_PHONE="70326 35858"

# 6. DOMAIN & CLOUDFLARE BOT PROTECTION
NEXT_PUBLIC_APP_URL="https://techbox.in"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# 7. EMAIL NOTIFICATIONS (Optional Resend or AWS SES)
EMAIL_PROVIDER="DEV_LOG"
RESEND_API_KEY=""
EMAIL_FROM="TechBox Orders <orders@techbox.in>"
