# TechBox Production Environment Configuration
# Copy this file to .env and configure for your deployment environment

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/techbox?schema=public"

# Auth & Session Security (Cryptographically random 32+ byte string)
AUTH_SECRET="replace_with_a_secure_random_production_secret"

# File Storage Provider: LOCAL (default) | S3 | R2
STORAGE_PROVIDER="LOCAL"

# Payment Provider: UPI_MANUAL (default for launch) | RAZORPAY | CASHFREE
PAYMENT_PROVIDER="UPI_MANUAL"

# Notification Provider: DEV_LOG (default) | RESEND | SES | WHATSAPP_API
EMAIL_PROVIDER="DEV_LOG"

# Business & Payment Identification (Public)
NEXT_PUBLIC_TECHBOX_WHATSAPP="917032635858"
NEXT_PUBLIC_TECHBOX_PHONE="70326 35858"
NEXT_PUBLIC_TECHBOX_UPI_ID="7032635858@ybl"
NEXT_PUBLIC_TECHBOX_UPI_NAME="PINNAM CHARLA CHARLA"
NEXT_PUBLIC_APP_URL="https://techbox.in"
